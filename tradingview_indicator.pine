//@version=6
indicator("US Stock & Cross-Asset Multi-Layered Trend System v2.29", shorttitle="v2.29 Quant System", overlay=true)

// ==========================================
// 1. Inputs & Configuration (Bilingual Support / 默认中文)
// ==========================================
grp_lang = "=== Language Setting / 语言设定 ==="
lang_input = input.string("中文", title="Language / 语言", options=["中文", "English"], group=grp_lang)

grp_mode = "=== Capital Allocation / 资金配置 ==="
nav_input = input.float(100000.0, title="Account NAV ($) / 账户总NAV", group=grp_mode)

grp_breadth = "=== S5FI Breadth / 宽度指标参数 ==="
s5fi_symbol = input.symbol("INDEX:S5FI", title="S5FI Ticker / 宽度指标代码", group=grp_breadth)
s5fi_l1_gate = input.float(45.0, title="L1 S5FI Gate Threshold (%) / L1 宽度闸门", group=grp_breadth)
s5fi_l2_gate = input.float(55.0, title="L2 S5FI Gate Threshold (%) / L2 宽度闸门", group=grp_breadth)

grp_indicators = "=== Moving Average & SuperTrend / 均线与 SuperTrend ==="
ema_len = input.int(200, title="EMA 200 Length / EMA 200 长度", group=grp_indicators)
st_period = input.int(10, title="SuperTrend Period / SuperTrend 周期", group=grp_indicators)
st_mult = input.float(3.0, title="SuperTrend Multiplier / SuperTrend 乘数", group=grp_indicators, step=0.1)

grp_display = "=== UI Display / 显示设定 ==="
table_pos_input = input.string("Top Right", title="Dashboard Position / 看板位置", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_display)

// Clean switch statement to prevent line continuation syntax errors
table_pos = switch table_pos_input
    "Top Right" => position.top_right
    "Top Left" => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

// ==========================================
// 2. Technical Indicators & Multi-Asset Data Fetching
// ==========================================
ema200 = ta.ema(close, ema_len)
plot(ema200, color=color.rgb(156, 163, 175), linewidth=2, title="EMA 200")

[st_val, st_dir] = ta.supertrend(st_mult, st_period)
st_color = st_dir < 0 ? color.rgb(0, 255, 204) : color.rgb(255, 94, 98)
plot(st_val, color=st_color, linewidth=2, title="SuperTrend")

// Fetch S5FI Market Breadth Index
s5fi_val = request.security(s5fi_symbol, "D", close, ignore_invalid_symbol=true)

// Fetch parent L1 data (SPY and QQQ EMAs and SuperTrend directions)
[spy_close, spy_ema, spy_dir, spy_dir_prev] = request.security("SPY", "D", [close, ta.ema(close, ema_len), st_dir, st_dir[1]], ignore_invalid_symbol=true)
[qqq_close, qqq_ema, qqq_dir, qqq_dir_prev] = request.security("QQQ", "D", [close, ta.ema(close, ema_len), st_dir, st_dir[1]], ignore_invalid_symbol=true)

// ==========================================
// 3. Auto-Identify Ticker Role in v2.29 System
// ==========================================
curr_ticker = syminfo.ticker

is_spy  = (curr_ticker == "SPY")
is_qqq  = (curr_ticker == "QQQ")
is_soxx = (curr_ticker == "SOXX")
is_qld  = (curr_ticker == "QLD")

is_gld  = (curr_ticker == "GLD")
is_tlt  = (curr_ticker == "TLT")
is_dbc  = (curr_ticker == "DBC")
is_bito = (curr_ticker == "BITO")

is_jepq = (curr_ticker == "JEPQ")
is_sgov = (curr_ticker == "SGOV")

is_equity_l1 = is_spy or is_qqq or is_soxx
is_equity_l2 = is_qqq or is_soxx or is_qld
is_non_equity = is_gld or is_tlt or is_dbc or is_bito
is_base_l0 = is_jepq
is_cash_pool = is_sgov

parent_name      = is_qqq ? "SPY" : (is_soxx or is_qld ? "QQQ" : "")
parent_close     = is_qqq ? spy_close : qqq_close
parent_ema       = is_qqq ? spy_ema : qqq_ema
parent_dir       = is_qqq ? spy_dir : qqq_dir
parent_dir_prev  = is_qqq ? spy_dir_prev : qqq_dir_prev

// ==========================================
// 4. Signal Calculations
// ==========================================
st_bullish_change = (st_dir[1] >= 0 and st_dir < 0)
st_bearish_change = (st_dir[1] < 0 and st_dir >= 0)

parent_st_bullish_change = (parent_dir_prev >= 0 and parent_dir < 0)
parent_st_bearish_change = (parent_dir_prev < 0 and parent_dir >= 0)

l1_gate_open = not na(s5fi_val) ? (s5fi_val >= s5fi_l1_gate) : true
l2_gate_open = not na(s5fi_val) ? (s5fi_val >= s5fi_l2_gate) : true

// Equity L1
equity_l1_buy_signal  = is_equity_l1 and (close > ema200) and st_bullish_change
equity_l1_sell_signal = is_equity_l1 and st_bearish_change

// Equity L2
parent_bullish = (parent_close > parent_ema) and (parent_dir < 0)
parent_l1_buy_signal = (parent_close > parent_ema) and parent_st_bullish_change

l2_buy_cond_a = parent_bullish and st_bullish_change
l2_buy_cond_b = (st_dir < 0) and parent_l1_buy_signal
equity_l2_buy_signal  = is_equity_l2 and (l2_buy_cond_a or l2_buy_cond_b)
equity_l2_sell_signal = is_equity_l2 and (st_bearish_change or parent_st_bearish_change)

// Non-Equity L1 (S5FI Exempt)
non_equity_buy_signal  = is_non_equity and (close > ema200) and st_bullish_change
non_equity_sell_signal = is_non_equity and st_bearish_change

gen_buy_signal  = (is_equity_l1 and equity_l1_buy_signal and l1_gate_open) or (is_equity_l2 and equity_l2_buy_signal and l2_gate_open) or (is_non_equity and non_equity_buy_signal)
gen_sell_signal = (is_equity_l1 and equity_l1_sell_signal) or (is_equity_l2 and equity_l2_sell_signal) or (is_non_equity and non_equity_sell_signal)

// ==========================================
// 5. Visual Signal Overlay (Stacked Labels)
// ==========================================
atr_val = ta.atr(14)
l1_buy_price  = low - (0.5 * atr_val)
l2_buy_price  = low - (2.0 * atr_val)
l1_sell_price = high + (0.5 * atr_val)
l2_sell_price = high + (2.0 * atr_val)

plotshape(is_equity_l1 and equity_l1_buy_signal and l1_gate_open ? l1_buy_price : na, title="L1 Buy", style=shape.labelup, location=location.absolute, color=color.rgb(0, 255, 204), text="L1 BUY", textcolor=color.black, size=size.normal)
plotshape(is_equity_l1 and equity_l1_sell_signal ? l1_sell_price : na, title="L1 Sell", style=shape.labeldown, location=location.absolute, color=color.rgb(255, 94, 98), text="L1 SELL", textcolor=color.white, size=size.normal)

plotshape(is_equity_l2 and equity_l2_buy_signal and l2_gate_open ? l2_buy_price : na, title="L2 Buy", style=shape.labelup, location=location.absolute, color=color.rgb(0, 162, 255), text="L2 BUY", textcolor=color.white, size=size.normal)
plotshape(is_equity_l2 and equity_l2_sell_signal ? l2_sell_price : na, title="L2 Sell", style=shape.labeldown, location=location.absolute, color=color.rgb(255, 166, 0), text="L2 SELL", textcolor=color.black, size=size.normal)

plotshape(is_non_equity and non_equity_buy_signal ? l1_buy_price : na, title="Cross-Asset Buy", style=shape.labelup, location=location.absolute, color=color.rgb(245, 158, 11), text="CROSS BUY", textcolor=color.black, size=size.normal)
plotshape(is_non_equity and non_equity_sell_signal ? l1_sell_price : na, title="Cross-Asset Sell", style=shape.labeldown, location=location.absolute, color=color.rgb(239, 68, 68), text="CROSS SELL", textcolor=color.white, size=size.normal)

// ==========================================
// 6. Sizing Calculation
// ==========================================
l1_alloc_pct = is_equity_l2 ? 0.08 : 0.10
alloc_dollars = nav_input * l1_alloc_pct
suggested_shares = math.round(alloc_dollars / close)

// ==========================================
// 7. Bilingual Translation & HUD Formatting
// ==========================================
is_cn = (lang_input == "中文")
t_header = is_cn ? "⚡ 美股/跨资产 v2.29 量化指挥台" : "⚡ v2.29 Quant Command HUD"
t_s5fi   = is_cn ? "S5FI 宽度指标" : "S5FI Market Breadth"
t_role_col = is_cn ? "标的角色" : "Asset Role"
t_action_col = is_cn ? "★ 实盘指令建议" : "★ Signal Recommendation"
t_shares_col = is_cn ? "★ 建议建仓份额" : "★ Suggested Order Size"
t_cap_check = is_cn ? "趋势层容量限制" : "Trend Capacity Limits"
t_cap_rule1 = is_cn ? "单标的: L1/跨资产 10%, L2 8% NAV" : "Single Asset: L1/Cross 10%, L2 8% NAV"
t_cap_rule2 = is_cn ? "趋势层上限: ≤ 55% NAV" : "Trend Total Cap: <= 55% NAV"
t_hierarchy_title = is_cn ? "资金调拨与底仓" : "Capital Hierarchy"
t_hierarchy_desc = is_cn ? "60% JEPQ(DRIP) + 40% SGOV利息池" : "60% JEPQ(DRIP) + 40% SGOV Cash"

string role_desc = "Custom Asset"
if is_base_l0
    role_desc := is_cn ? "L0 高股息底仓 (60% NAV)" : "L0 Base Allocation (60% NAV)"
else if is_cash_pool
    role_desc := is_cn ? "SGOV 闲置贴息池 (40% Initial)" : "SGOV Cash Pool (40% Initial)"
else if is_equity_l1
    role_desc := is_cn ? "美股权益 L1 母仓 (10% NAV)" : "Equity L1 Mother (10% NAV)"
else if is_equity_l2
    role_desc := is_cn ? "美股权益 L2 加速 (8% NAV, 对应: " + parent_name + ")" : "Equity L2 Accel (8% NAV, Parent: " + parent_name + ")"
else if is_non_equity
    role_desc := is_cn ? "跨资产趋势标的 (10% NAV, S5FI豁免)" : "Cross-Asset Trend (10% NAV, S5FI Exempt)"

var string rec_action = "-"
var color rec_color = color.gray
var string rec_shares = "-"

if is_base_l0
    rec_action := is_cn ? "长期持有 (DRIP)" : "Long-term Hold (DRIP)"
    rec_color  := color.rgb(59, 130, 246)
    rec_shares := is_cn ? "目标 60% NAV ($" + str.tostring(nav_input * 0.60, "#,###") + ")" : "Target 60% NAV ($" + str.tostring(nav_input * 0.60, "#,###") + ")"
else if is_cash_pool
    rec_action := is_cn ? "闲置利息池" : "Cash Yield Pool"
    rec_color  := color.rgb(16, 185, 129)
    rec_shares := is_cn ? "变现优先: SGOV -> JEPQ" : "Sell Priority: SGOV -> JEPQ"
else if is_equity_l1
    if equity_l1_sell_signal
        rec_action := is_cn ? "🔴 卖出平仓" : "🔴 SELL TO CLOSE"
        rec_color  := color.rgb(255, 94, 98)
        rec_shares := is_cn ? "全仓卖出" : "Sell All Shares"
    else if equity_l1_buy_signal
        if not l1_gate_open
            rec_action := is_cn ? "🟠 S5FI 宽度拦截" : "🟠 BLOCKED (S5FI < 45%)"
            rec_color  := color.orange
            rec_shares := is_cn ? "0 股 (禁买)" : "0 shares (Blocked)"
        else
            rec_action := is_cn ? "🟢 买入开仓" : "🟢 BUY TO OPEN"
            rec_color  := color.rgb(0, 255, 204)
            rec_shares := str.tostring(suggested_shares, "#") + (is_cn ? " 股 (约 $" : " shares (~$") + str.tostring(alloc_dollars, "#,###") + ")"
    else
        if st_dir < 0
            rec_action := is_cn ? "🔵 继续持股" : "🔵 HOLD POSITION"
            rec_color  := color.rgb(59, 130, 246)
            rec_shares := is_cn ? "保持 10% NAV 持仓" : "Hold 10% NAV Position"
        else
            rec_action := is_cn ? "⚪ 空仓观望" : "⚪ WAIT / NO POSITION"
            rec_color  := color.gray
            rec_shares := "0 股"
else if is_equity_l2
    if equity_l2_sell_signal
        rec_action := is_cn ? "🔴 卖出平仓" : "🔴 SELL TO CLOSE"
        rec_color  := color.rgb(255, 166, 0)
        rec_shares := is_cn ? "全仓卖出 (母仓或自身翻空)" : "Sell All (Parent/Self Bearish)"
    else if equity_l2_buy_signal
        if not l2_gate_open
            rec_action := is_cn ? "🟠 S5FI 宽度拦截" : "🟠 BLOCKED (S5FI < 55%)"
            rec_color  := color.orange
            rec_shares := is_cn ? "0 股 (禁买)" : "0 shares (Blocked)"
        else
            rec_action := is_cn ? "🟢 买入开仓" : "🟢 BUY TO OPEN"
            rec_color  := color.rgb(0, 162, 255)
            rec_shares := str.tostring(suggested_shares, "#") + (is_cn ? " 股 (约 $" : " shares (~$") + str.tostring(alloc_dollars, "#,###") + ")"
    else
        if st_dir < 0 and parent_bullish
            rec_action := is_cn ? "🔵 继续持股" : "🔵 HOLD POSITION"
            rec_color  := color.rgb(59, 130, 246)
            rec_shares := is_cn ? "保持 8% NAV 持仓" : "Hold 8% NAV Position"
        else
            rec_action := is_cn ? "⚪ 空仓观望" : "⚪ WAIT / NO POSITION"
            rec_color  := color.gray
            rec_shares := "0 股"
else if is_non_equity
    if non_equity_sell_signal
        rec_action := is_cn ? "🔴 卖出平仓" : "🔴 SELL TO CLOSE"
        rec_color  := color.rgb(239, 68, 68)
        rec_shares := is_cn ? "全仓卖出" : "Sell All Shares"
    else if non_equity_buy_signal
        rec_action := is_cn ? "🟢 买入开仓 (豁免S5FI)" : "🟢 BUY TO OPEN (S5FI Exempt)"
        rec_color  := color.rgb(245, 158, 11)
        rec_shares := str.tostring(suggested_shares, "#") + (is_cn ? " 股 (约 $" : " shares (~$") + str.tostring(alloc_dollars, "#,###") + ")"
    else
        if st_dir < 0
            rec_action := is_cn ? "🔵 继续持股" : "🔵 HOLD POSITION"
            rec_color  := color.rgb(59, 130, 246)
            rec_shares := is_cn ? "保持 10% NAV 持仓" : "Hold 10% NAV Position"
        else
            rec_action := is_cn ? "⚪ 空仓观望" : "⚪ WAIT / NO POSITION"
            rec_color  := color.gray
            rec_shares := "0 股"

// ==========================================
// 8. Drawing Dashboard HUD Table
// ==========================================
var table hudTable = table.new(position = table_pos, columns = 3, rows = 6, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.rgb(255, 255, 255, 15))

if barstate.islast
    table.cell(hudTable, 0, 0, t_header, bgcolor=color.rgb(31, 41, 55), text_color=color.white, text_size=size.small)
    table.cell(hudTable, 1, 0, (is_cn ? "标的: " : "Ticker: ") + curr_ticker + " @ $" + str.tostring(close, "0.00"), bgcolor=color.rgb(31, 41, 55), text_color=color.white, text_size=size.small)
    table.cell(hudTable, 2, 0, (is_cn ? "账户 NAV: $" : "Account NAV: $") + str.tostring(nav_input, "#,###"), bgcolor=color.rgb(31, 41, 55), text_color=color.white, text_size=size.small)
    
    s5fi_str = na(s5fi_val) ? (is_cn ? "加载中" : "Loading") : str.tostring(s5fi_val, "0.0") + "%"
    t_open = is_cn ? "开放" : "Open"
    t_closed = is_cn ? "关闭" : "Closed"
    gate_desc = is_non_equity ? (is_cn ? "跨资产: 豁免宽度限制" : "Cross-Asset: S5FI Exempt") : ("L1(45%): " + (l1_gate_open ? t_open : t_closed) + " | L2(55%): " + (l2_gate_open ? t_open : t_closed))
    
    table.cell(hudTable, 0, 1, t_s5fi, text_color=color.rgb(209, 213, 219), text_size=size.small)
    table.cell(hudTable, 1, 1, (is_cn ? "当前宽度: " : "Current Width: ") + s5fi_str, text_color=color.white, text_size=size.small)
    table.cell(hudTable, 2, 1, gate_desc, text_color=is_non_equity ? color.yellow : (l2_gate_open ? color.green : color.orange), text_size=size.small)
    
    table.cell(hudTable, 0, 2, t_role_col, bgcolor=color.rgb(17, 24, 39), text_color=color.white, text_size=size.small)
    table.cell(hudTable, 1, 2, t_action_col, bgcolor=color.rgb(17, 24, 39), text_color=color.white, text_size=size.small)
    table.cell(hudTable, 2, 2, t_shares_col, bgcolor=color.rgb(17, 24, 39), text_color=color.white, text_size=size.small)
    
    table.cell(hudTable, 0, 3, role_desc, text_color=color.rgb(147, 197, 253), text_size=size.small)
    table.cell(hudTable, 1, 3, rec_action, text_color=rec_color, text_size=size.small)
    table.cell(hudTable, 2, 3, rec_shares, text_color=rec_color, text_size=size.small)
    
    table.cell(hudTable, 0, 4, t_cap_check, text_color=color.rgb(156, 163, 175), text_size=size.small)
    table.cell(hudTable, 1, 4, t_cap_rule1, text_color=color.rgb(156, 163, 175), text_size=size.small)
    table.cell(hudTable, 2, 4, t_cap_rule2, text_color=color.rgb(156, 163, 175), text_size=size.small)
    
    table.cell(hudTable, 0, 5, t_hierarchy_title, text_color=color.rgb(156, 163, 175), text_size=size.small)
    table.cell(hudTable, 1, 5, t_hierarchy_desc, text_color=color.rgb(156, 163, 175), text_size=size.small)
    table.cell(hudTable, 2, 5, is_cn ? "建仓资金卖出顺序: SGOV -> JEPQ" : "Funding Sell Order: SGOV -> JEPQ", text_color=color.rgb(156, 163, 175), text_size=size.small)

// ==========================================
// 9. Alert Conditions for TradingView Alerts
// ==========================================
alertcondition(gen_buy_signal, title="v2.29 Buy Signal / 触发买入信号", message="[v2.29 Quant System] 🟢 BUY SIGNAL triggered on {{ticker}} at price {{close}}. Check dashboard for suggested order size.")
alertcondition(gen_sell_signal, title="v2.29 Sell Signal / 触发卖出信号", message="[v2.29 Quant System] 🔴 SELL SIGNAL triggered on {{ticker}} at price {{close}}. Close position on next market open.")
alertcondition(st_bullish_change, title="SuperTrend Bullish Flip / ST翻多", message="[v2.29 Quant System] ⚡ SuperTrend (10, 3) turned BULLISH on {{ticker}} at {{close}}.")
alertcondition(st_bearish_change, title="SuperTrend Bearish Flip / ST翻空", message="[v2.29 Quant System] ⚠️ SuperTrend (10, 3) turned BEARISH on {{ticker}} at {{close}}.")
